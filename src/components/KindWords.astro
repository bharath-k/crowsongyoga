---
import { site } from '../lib/content';
const { kind_words } = site;
---

<section id="kind-words" class="bg-sand-100/50 pt-8 pb-14 sm:pt-10 sm:pb-16">
  <div class="mx-auto max-w-5xl px-5">
    <h2 class="text-2xl font-semibold text-charcoal sm:text-3xl">{kind_words.heading}</h2>
    {kind_words.intro && <p class="mt-2 max-w-2xl text-sm text-muted">{kind_words.intro}</p>}
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        kind_words.items.map((item) => (
          <figure class="flex flex-col rounded-xl border border-sand-200 bg-sand-50 p-5">
            <blockquote class="text-sm leading-relaxed text-charcoal">
              <p>&ldquo;{item.quote}&rdquo;</p>
            </blockquote>
            <figcaption class="mt-3 text-xs font-semibold text-clay-dark">{item.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
